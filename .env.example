# Solana RPC endpoint. The public one works; a private one is faster. Never commit a URL with an API key.
RPC_URL=https://api.mainnet-beta.solana.com
# Requests per second to the RPC. Public endpoints throttle bursts — keep this low.
RPC_MAX_RPS=2

# Optional: Telegram alerts. Create a bot with @BotFather and put your chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Risk thresholds
TOP_HOLDER_WARN_PCT=25
TOP_HOLDER_DANGER_PCT=50
THIN_POOL_SOL=5

# Optional: append every alert as one JSON line to this file
ALERTS_JSONL=
