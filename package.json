{
  "name": "pumpfun-migration-alerts",
  "version": "1.0.0",
  "description": "Real-time pump.fun → PumpSwap migration alerts with on-chain risk flags. Read-only, free-RPC friendly.",
  "type": "module",
  "license": "MIT",
  "author": "Artem Vartanov",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts watch",
    "replay": "node --env-file-if-exists=.env --import tsx src/main.ts replay",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solana/web3.js": "1.98.4"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
